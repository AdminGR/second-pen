# OpenAI-compatible HTTP. Without a key, /api/draft returns a deterministic stub.
# Same vars work for OpenAI, OpenRouter, Groq, Ollama (/v1), or a local `llm` proxy.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Catalog: users (or we) point each tier at a model id the endpoint understands.
MODEL_LUNA=gpt-4o-mini
MODEL_TERRA=gpt-4o-mini
MODEL_SOL=gpt-4o
